# Local development template — copy to `.env.local` (gitignored).
# Points at the local Supabase stack from `yarn sb:start`. Never put production values here:
# production uses the same variable names, set in the hosting provider's environment settings
# (e.g. Vercel → Project → Settings → Environment Variables), never in a file in the repo.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" from `yarn sb:status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" from `yarn sb:status` — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# E2E tests (`yarn test:e2e`) — optional overrides, defaults are local placeholders.
# Must stay local (localhost / 127.0.0.1): playwright.config.ts refuses any other host.
# PLAYWRIGHT_SUPABASE_URL=http://127.0.0.1:54321
# PLAYWRIGHT_SUPABASE_ANON_KEY=
# PLAYWRIGHT_SUPABASE_SECRET_KEY=
